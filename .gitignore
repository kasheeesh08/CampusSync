# =============================================================================
# CampusSync root .gitignore
# Nested .gitignore files (app/, app/android/) still apply; lower-level files
# take precedence over this one.
# =============================================================================

# -----------------------------------------------------------------------------
# Developer-specific Firebase configuration (never commit)
# Generate your own: README.md, "Firebase setup".
# -----------------------------------------------------------------------------
# FlutterFire output for the maintainer's live project; template is
# app/lib/firebase_options_live.example.dart (that one IS committed).
app/lib/firebase_options_live.dart
google-services.json
GoogleService-Info.plist
# FlutterFire CLI metadata (real project id and app ids); regenerated by `flutterfire configure`.
app/firebase.json
# Firebase CLI project alias for your own project (`firebase use --add`).
.firebaserc
firebase.env.json

# -----------------------------------------------------------------------------
# Private credentials (never commit)
# -----------------------------------------------------------------------------
# Firebase Admin SDK / Google Cloud service-account keys
*service-account*.json
*service_account*.json
*serviceAccount*.json
*-sa.json
*firebase-adminsdk*.json
application_default_credentials.json
# Android signing
*.jks
*.keystore
key.properties
# Keys, certificates, environment files
*.pem
*.p12
*.pfx
*.key
.env*
!.env.example

# -----------------------------------------------------------------------------
# Material not part of the public project
# -----------------------------------------------------------------------------
# College source documents (institutional material, not ours to publish)
/basic ppt/
/final exam timetable/
/important doc/
/project rubrics/
/floor wise college layout/
# Local archive and internal progress log
/app.zip
/*.zip
/IMPLEMENTATION_STATUS.md
# Academic submission report: lists team members' full names and roll numbers.
# Publish only with every member's consent (or after removing that table).
/docs/report/

